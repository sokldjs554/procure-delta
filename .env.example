# ProcureDelta local configuration. Keep secrets out of source control.
DATABASE_URL=postgresql+psycopg://procure_delta:procure_delta@postgres:5432/procure_delta
REDIS_URL=redis://redis:6379/0
ATTACHMENT_STORAGE_BACKEND=local
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_PREFIX=procure-delta
ATTACHMENT_S3_REGION=
ATTACHMENT_S3_ENDPOINT_URL=
ATTACHMENT_S3_ACCESS_KEY_ID=
ATTACHMENT_S3_SECRET_ACCESS_KEY=
# Fixture mode keeps the local synthetic demo reproducible. Use tesseract for real PDFs.
OCR_BACKEND=fixture
OCR_TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata
OCR_LANGUAGE=kor+eng
OCR_DPI=300
OCR_MAX_PAGES=10
OCR_MAX_PIXELS_PER_PAGE=12000000
OCR_TIMEOUT_SECONDS=40
KONEPS_ENABLED=false
KONEPS_SERVICE_KEY=
KONEPS_LOOKBACK_DAYS=1
KONEPS_PAGES_PER_POLL=5
EXTRACTION_MODE=deterministic
EXTRACTION_ENDPOINT=
EXTRACTION_PROVIDER=
EXTRACTION_MODEL=
EXTRACTION_API_KEY=
EXTRACTION_MAX_COMPLETION_TOKENS=4096
NOTIFICATION_EXTERNAL_ENABLED=false
NOTIFICATION_WEBHOOK_DESTINATIONS={}
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_STARTTLS=true
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_EMAIL_SENDER=
NOTIFICATION_EMAIL_RECIPIENTS={}
DEMO_AUTH_ENABLED=true
DEMO_OPERATOR_SECRET=
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
RELEASE_REVISION=development
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional same-origin routing: empty NEXT_PUBLIC_API_URL and set this before building web.
# For Docker Compose the upstream is http://api:8000; Render uses the API's HTTPS origin.
API_PROXY_ORIGIN=
POSTGRES_DB=procure_delta
POSTGRES_USER=procure_delta
POSTGRES_PASSWORD=procure_delta
