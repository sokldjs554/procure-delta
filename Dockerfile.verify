FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-nanum \
    tesseract-ocr \
    tesseract-ocr-kor \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN pip install --no-cache-dir -e "./apps/api[dev]"
ENV PYTHONPATH=/workspace/apps/api
ENV RUN_ENVIRONMENT=isolated-docker-verification
CMD ["python", "scripts/container_checks.py"]
